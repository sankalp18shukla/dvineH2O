# ─── App ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keys hashes of IPs / rate-limit identifiers. 32+ random characters:  openssl rand -base64 48
APP_SECRET=

# ─── Supabase (Project Settings › API Keys). Server-side only: never prefix these with NEXT_PUBLIC_ ───
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key (or legacy service_role key). Used for Auth admin + Storage only. Never commit, never expose.
SUPABASE_SECRET_KEY=sb_secret_...

# ─── Database ───────────────────────────────────────────
# What the website uses: Supabase › Connect › Transaction pooler (port 6543), signed in as the
# least-privilege role dvine_app (user "dvine_app.<project-ref>"), password = DATABASE_APP_PASSWORD below.
DATABASE_URL=postgresql://dvine_app.<project-ref>:<DATABASE_APP_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Only for `npm run db:migrate / db:seed / db:import / db:check` from your machine (Session pooler, owner role).
# Do NOT set this on Vercel.
DATABASE_ADMIN_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Password `npm run db:migrate` gives dvine_app (24+ chars):  openssl rand -base64 32 | tr -d '/+='
DATABASE_APP_PASSWORD=

# First admin, created by `npm run db:seed` (12+ characters). Remove the password afterwards.
SEED_ADMIN_EMAIL=admin@dvineh2o.com
SEED_ADMIN_PASSWORD=

# ─── Staff sign-in ──────────────────────────────────────
# Hours before a staff session must sign in again (1–24).
STAFF_SESSION_HOURS=12
# Two-step sign-in (authenticator app) is always required in production. Only for local dev / tests:
# STAFF_MFA_REQUIRED=false

# ─── Payments ───────────────────────────────────────────
# Which gateway takes new payments: phonepe | razorpay. Blank = PhonePe if its keys are set,
# else Razorpay, else the built-in TEST MODE gateway. Refunds always use the original gateway.
PAYMENT_GATEWAY=

# ─── PhonePe Standard Checkout v2 (PhonePe Business dashboard › Developer Settings) ───
# PHONEPE_ENV=sandbox uses UAT keys; set to production with live keys to take real money.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Webhook username/password you choose in the PhonePe dashboard (URL: /api/webhooks/phonepe)
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ─── Razorpay (optional alternative) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Shiprocket (leave blank to record shipments manually) ───
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=

# ─── Email (SMTP) for order / enquiry messages. Blank = messages are logged in Admin › Notifications ───
# (Sign-up, password-reset and other account emails are sent by Supabase Auth — set its SMTP in the dashboard.)
# Team inbox for alerts (a new service request). Several addresses: separate with commas. Blank = dashboard only.
TEAM_ALERT_EMAIL=reachout@dvineh2o.com
# dvineh2o.com mail is Google Workspace: smtp.gmail.com, port 587, and an App Password for SMTP_PASS
# (Google account › Security › 2-Step Verification › App passwords), not the mailbox password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DVINE H2O <reachout@dvineh2o.com>"

# Reply-to for customer emails (optional; e.g. the inbox the team reads). Blank = replies go to MAIL_FROM.
MAIL_REPLY_TO=customercare@dvineh2o.com

# ─── WhatsApp Cloud API (Meta) ───
# Every customer message is an approved template (src/lib/whatsapp-templates.ts). After filling these in, run
# `npm run whatsapp:templates` once to submit them to Meta, then `npm run whatsapp:templates -- --status`.
# WHATSAPP_TOKEN: a permanent System User token (whatsapp_business_messaging + whatsapp_business_management).
# WHATSAPP_PHONE_ID: the Phone number ID (not the number itself). WHATSAPP_WABA_ID: the WhatsApp Business Account ID.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE_LANG=en
NEXT_PUBLIC_WHATSAPP_NUMBER=918984163478

# ─── Google Sheets (Admin › Settings › Google Sheets) ───
# A Google Cloud service account with the Google Sheets API enabled. The team shares each sheet with
# its email as an Editor. Paste the whole JSON key file (raw or base64), or the two fields separately.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=dvine-sheets@<project>.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Protects /api/cron/maintenance (24+ random characters)
CRON_SECRET=

# Built-in test payments when no gateway keys are set. Never enable on the live site.
ALLOW_TEST_PAYMENTS=false

# ─── Analytics and search (all optional: nothing loads until set) ───
# Google Analytics 4 measurement ID ("G-XXXXXXX") and Meta Pixel ID (digits). Counts visits and completed purchases.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Google Search Console ownership check: the content="…" value of the HTML-tag method
GOOGLE_SITE_VERIFICATION=
