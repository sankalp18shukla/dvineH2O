# ─── App ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Long random string used to sign login sessions (openssl rand -base64 48)
AUTH_SECRET=change-me-to-a-long-random-string

# ─── Database ───────────────────────────────────────────
# Local SQLite file by default. For production use Turso/libSQL:
#   DATABASE_URL=libsql://your-db.turso.io   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/dvine.db
DATABASE_AUTH_TOKEN=

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@dvineh2o.com
SEED_ADMIN_PASSWORD=ChangeMe!2026

# ─── Payments ───────────────────────────────────────────
# Which gateway takes new payments: phonepe | razorpay. Blank = PhonePe if its keys are set,
# else Razorpay, else the built-in TEST MODE gateway. Refunds always use the original gateway.
PAYMENT_GATEWAY=

# ─── PhonePe Standard Checkout v2 (PhonePe Business dashboard › Developer Settings) ───
# PHONEPE_ENV=sandbox uses UAT keys; set to production with live keys to take real money.
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Webhook username/password you choose in the PhonePe dashboard (URL: /api/webhooks/phonepe)
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ─── Razorpay (optional alternative) ───
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Shiprocket (leave blank to record shipments manually) ───
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=

# ─── Email (SMTP). Blank = messages are logged in Admin › Notifications ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DVINE H2O <care@dvineh2o.com>"

# ─── WhatsApp Cloud API (optional) ───
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=918984163478

# Protects /api/cron/maintenance (abandoned carts, stale reservations)
CRON_SECRET=change-me

# Built-in test payments when no gateway keys are set. Never enable on the live site.
ALLOW_TEST_PAYMENTS=false
